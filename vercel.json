{
    "framework": "vite",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "dj-flowerz.vercel.app"
                }
            ],
            "destination": "https://djflowerz.co.ke/$1",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/api/v1/products",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "s-maxage=60, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(.*)\\.(ico|jpg|jpeg|png|gif|svg|webp|css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/r2/(.*)",
            "destination": "https://pub-8ce7dd1a0bfc42fb9e3a130e1f5f5aae.r2.dev/$1"
        },
        {
            "source": "/mashups/(.*)",
            "destination": "https://remix-and-mashups-worker.dennismacharia20.workers.dev/$1"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}