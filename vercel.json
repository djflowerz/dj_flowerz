{
    "framework": "vite",
    "headers": [
        {
            "source": "/api/v1/products",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "s-maxage=60, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(.*)\\.(ico|jpg|jpeg|png|gif|svg|webp|css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}